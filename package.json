{
  "name": "ports",
  "version": "1.0.0",
  "description": "TUI for localhost dev servers",
  "bin": {
    "ports": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --target=node20 --packages=external --define:__VERSION__='\"'\"$npm_package_version\"'\"' --outfile=dist/index.js && chmod +x dist/index.js",
    "build:binary": "bun build src/index.tsx --compile --define:__VERSION__='\"'\"$npm_package_version\"'\"' --outfile ports",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/core.test.ts && tsx src/view.test.ts && tsx src/web.test.ts && tsx src/smoke.tsx",
    "dev": "tsx src/index.tsx"
  },
  "keywords": [
    "ports",
    "cli",
    "tui",
    "localhost",
    "dev-server"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.1",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.1",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
