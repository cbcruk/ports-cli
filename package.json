{
  "name": "ports",
  "version": "1.0.0",
  "description": "CLI/TUI for localhost dev servers",
  "bin": { "ports": "./dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js && chmod +x dist/index.js",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/core.test.ts && tsx src/view.test.ts",
    "dev": "tsx src/index.tsx",
    "watch": "tsx src/index.tsx -w"
  },
  "keywords": ["ports", "cli", "tui", "localhost", "dev-server"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
